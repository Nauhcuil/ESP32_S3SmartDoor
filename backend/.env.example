# ============================================================
# 门禁桥接后端本地配置示例
# 复制为 .env（或直接在 PowerShell 里设置同名环境变量）。
# 所有值都是占位符，请勿把真实凭据提交到仓库。
# ============================================================

# 监听端口
PORT=8080

# 1 = 演示模式：完全不访问巴法云，返回模拟设备/记录，供界面与联调使用
MOCK=0

# 巴法云私钥（UID）。等价于设备 NVS 里 net_cfg/bemfa_uid 的值。
# 只保存在服务端，绝不写进小程序。
BEMFA_UID=<YOUR_BEMFA_UID>

# 主题串，必须与设备配网页填写的“巴法云主题”完全一致（逗号分隔，顺序固定）：
#   ACCESS,CMD,STATUS,STRANGER
# 只填 1~3 个时，设备会按固件的降级映射使用；后端已复刻同一套映射。
BEMFA_TOPICS=<ACCESS_TOPIC>,<CMD_TOPIC>,<STATUS_TOPIC>,<STRANGER_TOPIC>

# 命令发布时是否追加后缀。留空=直接发主题；联调发现设备收不到时改成 /set
BEMFA_PUBLISH_SUFFIX=

# 管理员 PIN：必须与设备 NVS 里的 admin_pin 一致（出厂默认 1234，最多 8 位数字）。
# 仅服务端保存，用于登录校验 + 代填命令 token。
ADMIN_PIN=<DEVICE_ADMIN_PIN>

# 会话签名密钥：随机字符串，至少 32 字符（可用 openssl rand -hex 32 生成）
SESSION_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARS>

# 远程开门限速（次/分钟）。固件自身也限速 3 次/分钟，这里不要设得更大。
OPEN_LIMIT_PER_MIN=3

# 巴法云 HTTP 接口基础地址（一般不用改，测试时可指向本地假服务）
BEMFA_BASE_URL=https://apis.bemfa.com

# 单次上游请求超时（毫秒）
UPSTREAM_TIMEOUT_MS=8000
